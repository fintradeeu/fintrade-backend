# Database
DATABASE_URL=postgresql+asyncpg://lms_user:lms_password@postgres:5432/lms_db

# JWT
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=360
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_NAME=FinTrade LMS
APP_VERSION=1.0.0
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:5173,https://affiliate.thefintrade.com

# AI
AI_PROVIDER=gemini
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo
EMBEDDING_MODEL=text-embedding-ada-002

# Market Data
TWELVE_DATA_API_KEY=your-twelve-data-api-key
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=60
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=60

# Milvus (optional)
MILVUS_HOST=milvus
MILVUS_PORT=19530
USE_MILVUS=false

# Email (SMTP stub)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@fittrade.com

# WhatsApp Cloud API
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Redis (optional)
REDIS_URL=redis://redis:6379/0

# Google OAuth (Accepts multiple comma-separated client IDs, e.g., web and mobile client IDs)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret


# Admin seed credentials
ADMIN_EMAIL=admin@platform.com
ADMIN_PASSWORD=admin123!
ADMIN_FULL_NAME=Platform Admin

# SMS OTP gateway
# Use route=q as a temporary workaround if the Fast2SMS OTP route is blocked
# on the account. The backend will also retry q automatically when otp fails.
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=otp
FAST2SMS_SENDER_ID=
FAST2SMS_MESSAGE_ID=

# Nimbus SMS OTP gateway
NIMBUS_SMS_BASE_URL=http://nimbusit.biz/api/SmsApi/SendSingleApi
NIMBUS_SMS_USER_ID=
NIMBUS_SMS_PASSWORD=
NIMBUS_SMS_SENDER_ID=
NIMBUS_SMS_ENTITY_ID=
NIMBUS_SMS_TEMPLATE_ID=
NIMBUS_SMS_MESSAGE_TEMPLATE="Welcome to FinTrade.\n\nUse OTP {code} to verify your FinTrade account and continue your registration. This code will expire in {expiry_minutes} minutes. For your security, never share your OTP with anyone.\n\nTeam FinTrade"
